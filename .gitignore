# ── Terraform ──────────────────────────────────────────────────────────────────

# Local plugin/module cache — never commit, regenerated by terraform init
**/.terraform/*

# State files — managed remotely (S3); local copies must never be committed
*.tfstate
*.tfstate.*
*.tfstate.backup

# Plan output files — contain sensitive data, environment-specific
*.tfplan

# Crash logs
crash.log
crash.*.log

# Override files — local developer patches, not for shared use
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# JSON-encoded tfvars — typically machine-generated and may contain secrets
*.tfvars.json

# Lock files are committed intentionally for reproducible provider versions
# DO NOT add .terraform.lock.hcl here

# ── Secrets & credentials ───────────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
.env
.env.*
credentials
credentials.json

# ── OS ─────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editors ────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
